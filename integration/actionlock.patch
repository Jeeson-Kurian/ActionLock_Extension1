+def _known(value):
+    if isinstance(value, dict):
+        return all(_known(v) for v in value.values())
+    if isinstance(value, list):
+        return all(_known(v) for v in value)
+    return value is False
+
+
+def _only_allowed_tags(change, keys):
+    if (change.action != "update" or change.previous_address or change.importing or change.deposed
+            or change.replace_paths or not _known(change.after_unknown)):
+        return False
+    before, after = change.before, change.after
+    if not isinstance(before, dict) or not isinstance(after, dict) or "tags" not in before or "tags" not in after:
+        return False
+    for field in before.keys() | after.keys():
+        if field in {"tags", "tags_all"}:
+            left, right = before.get(field), after.get(field)
+            if not isinstance(left, dict) or not isinstance(right, dict):
+                return False
+            if any(not isinstance(v, str) for v in (*left.values(), *right.values())):
+                return False
+            if any(left.get(k) != right.get(k) for k in (left.keys() | right.keys()) - set(keys)):
+                return False
+        elif field not in before or field not in after or canonical_json(before[field]) != canonical_json(after[field]):
+            return False
+    return True
+
